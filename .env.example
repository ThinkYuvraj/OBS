# ==============================================================================
# MarketinGlu Sub-Second OBS Broadcast Suite - Production Environment Template
# Copy to .env and configure for your deployment environment
# ==============================================================================

# Core Server Configuration
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=*

# Razorpay Commercial Payment Gateway & License Passes
# Pricing: ₹499/hr (Hourly Pass), ₹1,699/day (24h Pass), ₹4,999 (Season Pass)
RAZORPAY_KEY_ID=rzp_live_your_merchant_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# Tier 3: Hostinger MySQL Cold-Storage & phpMyAdmin Persistence
# (Leave blank to operate purely in high-speed in-memory mode)
HOSTINGER_DB_HOST=srv1234.hstgr.io
HOSTINGER_DB_USER=u123456789_broadcast
HOSTINGER_DB_PASSWORD=your_secure_db_password
HOSTINGER_DB_NAME=u123456789_broadcast_db
HOSTINGER_DB_PORT=3306

# Logging Level (INFO, WARN, ERROR, DEBUG)
LOG_LEVEL=INFO
