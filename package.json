{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node dist/server.js",
    "start:dev": "tsx server.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild server.ts --platform=node --bundle --format=esm --outfile=dist/server.js --packages=external",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "validate": "npm run lint && npm run build",
    "test:smoke": "node -e \"import('./dist/server.js').then(() => { console.log('Smoke test passed'); setTimeout(() => process.exit(0), 1000); }).catch(e => { console.error(e); process.exit(1); })\"",
    "docker:build": "docker build -t marketinglu-obs:latest .",
    "docker:run": "docker run -p 3000:3000 --env-file .env marketinglu-obs:latest",
    "docker:compose": "docker compose up -d",
    "docker:compose:down": "docker compose down",
    "docker:compose:dev": "docker compose -f docker-compose.dev.yml up"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "mysql2": "^3.24.5",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
